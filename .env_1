# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/n8n-pricing

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=7d

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=n8n Pricing

# Frontend URLs (for CORS + email links)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# First admin (used by seed script)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=change_this_immediately

# ── n8n Integration ──────────────────────────────────────────────────────────
N8N_BASE_URL=https://your-n8n-instance.example.com
N8N_WEBHOOK_SECRET=your-shared-secret-here
N8N_WF1_PATH=/webhook/quote-request
N8N_WF23_PATH=/webhook/confirm-clarification

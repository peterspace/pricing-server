# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# ── Frontend URLs (for CORS + email links) ────────────────────────────────────
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
AGENT_URL=http://localhost:5175

# ── n8n Integration ───────────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.srv1555257.hstgr.cloud
N8N_WEBHOOK_SECRET=your-webhook-secret-here

# Client calculator workflows
# Testing  → webhook-test URLs (synchronous, requires active editor)
# Production → webhook URLs (async, requires Publish)
N8N_WF1_PATH=/webhook-test/quote-request
N8N_WF23_PATH=/webhook-test/confirm-clarification

# Agent workflows
N8N_WF1_AGENT_PATH=/webhook-test/agent-quote-request
N8N_WF23_AGENT_PATH=/webhook-test/agent-confirm-clarification

# ── Google OAuth (for tKle Agent app) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
AGENT_GOOGLE_CALLBACK_URL=http://localhost:4000/api/agent/auth/google/callback
AGENT_APP_URL=http://localhost:5175

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Seed (run once to create first admin — then comment out in index.js) ──────
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
